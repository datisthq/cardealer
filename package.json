{
  "name": "@cardealer/root",
  "version": "0.4.0",
  "private": true,
  "description": "Fairspec cardealer extension",
  "homepage": "https://datisthq.github.io/cardealer",
  "author": "Evgeny Karev",
  "repository": "https://github.com/datisthq/cardealer",
  "type": "module",
  "scripts": {
    "build": "pnpm -C typescript build && pnpm -C python build && pnpm -C rust build",
    "deps": "ncu -ws -u --cooldown 7d",
    "docs:build": "livemark build",
    "docs:start": "livemark start",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "lint": "vp fmt --check && vp lint",
    "prepare": "lefthook install && mkdir -p .claude && ln -sfn ../.agents/skills .claude/skills",
    "publish:profiles": "node .scripts/@publish.ts",
    "release:py": "uv --directory python publish",
    "release:ts": "pnpm -r publish --access public --ignore-scripts --no-git-checks",
    "scan": "pnpm leaks && pnpm vulns",
    "start": "livemark start",
    "test": "pnpm lint && pnpm type && pnpm test:unit",
    "test:unit": "vp test && pnpm -C typescript test:unit && pnpm -C python test:unit && pnpm -C rust test:unit",
    "type": "tsgo --noEmit && pnpm -C typescript type && pnpm -C python type && pnpm -C rust type",
    "vulns": "semgrep --config=p/typescript --config=p/python --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --metrics=off"
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "0.4.4",
    "@tanstack/react-router": "1.168.1",
    "@tanstack/react-start": "1.167.2",
    "@types/node": "24.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "ajv": "8.17.1",
    "cn": "0.2.4",
    "lefthook": "2.1.1",
    "livemark": "0.29.3",
    "lucide-react": "0.577.0",
    "npm-check-updates": "23.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "slug": "cardealer",
  "title": "Fairspec Cardealer"
}
